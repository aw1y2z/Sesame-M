<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      不申请 INTERNET：本 APK 的界面进程不发起任何出站请求。
      · AI 答题与各任务接口都在注入的支付宝进程里请求，用宿主自己的网络权限
      · NanoHTTPD 监听 127.0.0.1:8080 也发生在宿主主进程，入站监听本就不需要该权限
      · 因此配置页不再提供「测试响应」，改成只读提示
    -->
    <!--
      配置写在 /sdcard/Android/media/<宿主包名>/ 下：
      · Android 11+ 只需要 MANAGE_EXTERNAL_STORAGE（PermissionUtil 也只检查 isExternalStorageManager）
      · Android 10 及以下才用得到这两个运行时权限，故用 maxSdkVersion 收窄，避免在高版本
        装上一对永远拿不到、也用不到的可读写权限
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 好友统计里点好友要先把支付宝切到前台（否则宿主进程的页面跳转会被后台启动限制拦截） -->
    <queries>
        <package android:name="com.eg.android.AlipayGphone" />
    </queries>

    <!--
      不再声明 usesCleartextTraffic：本 APK 不发起请求，明文 http 是否放行取决于
      支付宝自己的网络安全配置，与本 APK 无关。
    -->
    <application
        android:name=".SesameApplication"
        android:allowBackup="false"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@drawable/logo"
        android:theme="@style/AppTheme"
        tools:targetApi="q">

        <activity
            android:name=".ui.miuix.MiuixMainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            tools:targetApi="n">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.miuix.MiuixSettingsActivity"
            android:exported="false"
            android:resizeableActivity="true"
            tools:targetApi="n" />

        <activity
            android:name=".ui.miuix.MiuixGroupFieldsActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixSelectionEditActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixExtensionsActivity"
            android:exported="false"
            android:resizeableActivity="true"
            tools:targetApi="n" />

        <activity
            android:name=".ui.miuix.MiuixLogViewerActivity"
            android:exported="false"
            android:resizeableActivity="true"
            tools:targetApi="n" />

        <activity
            android:name=".ui.miuix.MiuixFriendStatsActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.miuix.MiuixAboutActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity-alias
            android:name=".ui.MainActivityAlias"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="io.github.aw1y2z.sesame.ui.miuix.MiuixMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
    </application>

</manifest>